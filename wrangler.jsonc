// Cloudflare Workers static-assets deployment for useomniclip.com.
// No build step: the repo root is the site. Deploy with: npx wrangler deploy
// (.assetsignore keeps repo-only files such as tests and docs off the site)
{
  "name": "omniclip",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "useomniclip.com", "custom_domain": true },
    { "pattern": "www.useomniclip.com", "custom_domain": true }
  ]
}
